# llm-d-guide cluster parameters
# Copy to cluster.env and edit:  cp cluster.env.example cluster.env
# Load:  source ./cluster.env
#
# cluster.env is gitignored — keep secrets (HF_TOKEN) only there.
# Do not commit site-specific values; only this example is tracked.

# ── User choices (set before Phase 1 / 2) ───────────────────────────
export CLOUD=                             # aws | none  (required)
export TLS_ISSUER=                        # letsencrypt | local-ca  (required)
export AWS_INSTANCE_TYPE=g5.2xlarge       # guide default (1× NVIDIA A10G); AWS only
export AWS_INSTANCES_PER_AZ=1
export GPU_AZS="a"                        # "a" for lab | "a b c" when the cluster has 3 AZs

# ── Later phases ────────────────────────────────────────────────────
export RHOAI_OLM_PROFILE=stable           # stable | ea
export GATEWAY_NAME=openshift-ai-inference
export PROJECT=llm-d-demo
# export HF_TOKEN=                        # Phase 5+ (gated models)

# ── Auto-derived from the logged-in cluster ─────────────────────────
if command -v oc >/dev/null 2>&1 && oc auth can-i get infrastructure.config.openshift.io >/dev/null 2>&1; then
  export CLUSTER_DOMAIN="$(oc get dns.config/cluster -o jsonpath='{.spec.baseDomain}')"
  export AWS_REGION="$(oc get infrastructure cluster -o jsonpath='{.status.platformStatus.aws.region}')"
  export INFRA_ID="$(oc get infrastructure cluster -o jsonpath='{.status.infrastructureName}')"
  export AMI_ID="$(oc get machineset -n openshift-machine-api -o jsonpath='{.items[0].spec.template.spec.providerSpec.value.ami.id}')"
else
  echo "cluster.env: oc not ready — CLUSTER_DOMAIN / AWS_REGION / INFRA_ID / AMI_ID not derived" >&2
fi

echo "cluster.env loaded:"
echo "  CLOUD=${CLOUD:-(unset)}  TLS_ISSUER=${TLS_ISSUER:-(unset)}  AWS_INSTANCE_TYPE=${AWS_INSTANCE_TYPE}"
echo "  GPU_AZS=${GPU_AZS}  AWS_INSTANCES_PER_AZ=${AWS_INSTANCES_PER_AZ}"
echo "  PROJECT=${PROJECT}  GATEWAY_NAME=${GATEWAY_NAME}  RHOAI_OLM_PROFILE=${RHOAI_OLM_PROFILE}"
if [[ -n "${INFRA_ID:-}" ]]; then
  echo "  INFRA_ID=${INFRA_ID}  AWS_REGION=${AWS_REGION}  CLUSTER_DOMAIN=${CLUSTER_DOMAIN}"
  echo "  AMI_ID=${AMI_ID}"
fi
